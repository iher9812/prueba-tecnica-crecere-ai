# Copia este archivo como .env y completa tus claves reales.
# .env NUNCA se sube al repo (está en .gitignore).

# API key de Kimi (Moonshot AI) — usada para el análisis cualitativo por LLM
# de cada transcripción (Fase 2: extract_features.py)
KIMI_API_KEY=

# Token de HuggingFace — usado para descargar los modelos de diarización
# de pyannote.audio (Fase 1: transcribe.py). Se obtiene en:
# https://huggingface.co/settings/tokens
# (requiere haber aceptado los términos de uso de los modelos
# pyannote/speaker-diarization-3.1 y pyannote/segmentation-3.0)
HF_TOKEN=
